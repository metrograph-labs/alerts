{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/alerts",
  "description": "The signal core of the alert system: the contracts of the event, the source and the channel.",
  "keywords": [
    "alerts",
    "cap",
    "common-alerting-protocol",
    "emergency",
    "warnings",
    "incidents",
    "escalation",
    "fema-lifelines"
  ],
  "homepage": "https://github.com/metrograph-labs/alerts/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/metrograph-labs/alerts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metrograph-labs/alerts.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "version": "0.2.8",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/algebra": "^0.9.9",
    "@mark1russell7/collections": "^0.11.2",
    "@mark1russell7/geo": "^0.5.3",
    "@mark1russell7/interval": "^0.1.0",
    "@mark1russell7/optional": "^1.5.0",
    "@mark1russell7/quantity": "^0.4.3",
    "@mark1russell7/rigor-generators": "^0.2.4",
    "@mark1russell7/rigor-statistics": "^0.2.21",
    "@mark1russell7/text": "^0.0.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rational": "^0.1.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
