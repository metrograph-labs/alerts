{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/alerts-source-nwws",
  "version": "0.1.0",
  "private": true,
  "description": "The source adapter of the alert system for NWWS-OI, the Open Interface of the NOAA Weather Wire Service: the CAP messages of the NWS from its XMPP stream.",
