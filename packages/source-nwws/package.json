    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/alerts": "workspace:*",
    "@mark1russell7/alerts-format-cap": "workspace:*",
    "@mark1russell7/alerts-format-nws": "workspace:*",
    "@mark1russell7/algebra": "^0.9.9",
    "@mark1russell7/service": "^0.12.0",
    "@mark1russell7/text": "^0.0.17",
    "@xmpp/client": "^0.14.0"
  },
  "devDependencies": {
    "@mark1russell7/alerts-source-nws-api": "workspace:*",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-testkit": "^0.1.20",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "ltx": "^3.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
