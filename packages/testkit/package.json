    "@mark1russell7/alerts-shapes-nws": "workspace:*",
    "@mark1russell7/alerts-source-gdelt": "workspace:*",
    "@mark1russell7/alerts-source-gtfs-alerts": "workspace:*",
    "@mark1russell7/alerts-source-iem": "workspace:*",
    "@mark1russell7/alerts-source-ipaws": "workspace:*",
    "@mark1russell7/alerts-source-nws-api": "workspace:*",
    "@mark1russell7/alerts-source-nwws": "workspace:*",
