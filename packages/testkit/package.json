{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/alerts-testkit",
  "description": "The fault suite of the alert system: each source and each channel behind a fault proxy, with a gate for each case.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "faults": "node scripts/fault-cases.ts"
  },
  "dependencies": {
