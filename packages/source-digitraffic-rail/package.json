{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/alerts-source-digitraffic-rail",
  "version": "0.1.0",
  "private": true,
  "description": "The source adapter of the alert system for the passenger trains of Finland from the open rail API of Digitraffic: the running, late and cancelled trains, as indicator readings.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/alerts": "workspace:*",
    "@mark1russell7/alerts-fetch": "workspace:*",
    "@mark1russell7/algebra": "^0.9.9",
    "@mark1russell7/optional": "^1.5.0",
    "@mark1russell7/text": "^0.0.18",
    "polite-crawler": "^0.7.12"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
