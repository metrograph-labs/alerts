    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/alerts": "workspace:*",
    "@mark1russell7/alerts-fetch": "workspace:*",
    "@mark1russell7/alerts-format-cap": "workspace:*",
    "@mark1russell7/alerts-format-nws": "workspace:*",
