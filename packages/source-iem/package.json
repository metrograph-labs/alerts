{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/alerts-source-iem",
  "version": "0.1.0",
  "private": true,
  "description": "The source adapter of the alert system for the Iowa Environmental Mesonet: the VTEC events of the NWS in effect, by county and zone.",
  "type": "module",
