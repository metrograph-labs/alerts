    "polite-crawler": "^0.7.12"
  },
  "devDependencies": {
    "@mark1russell7/algebra": "^0.9.9",
    "@mark1russell7/alerts-runtime": "workspace:*",
    "@mark1russell7/alerts-source-nws-api": "workspace:*",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/rigor-statistics": "^0.2.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
