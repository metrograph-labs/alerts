{
  "$schema": "https://json.schemastore.org/package",
  "name": "alerts-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint:ste": "ste-lint",
    "check:boundaries": "depcruise --config .dependency-cruiser.ts packages",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "sitePages": {
    "bareErrors": "fail"
  },
  "conventions": {
    "rules": {
      "gate-trigger": {
        "allow": [
          "measure.yml",
          "measure-wea.yml",
          "measure-state.yml",
          "measure-fold.yml",
          "measure-start.yml",
          "measure-snapshot.yml"
        ],
        "reason": "measure.yml and measure-wea.yml are measures of outside servers. measure-state.yml is a measure of the state for each quiet horizon, measure-fold.yml is a CPU profile of a start, measure-start.yml is a CPU profile of a start with live alerts and persons, and measure-snapshot.yml is the start with a snapshot and with no snapshot. They are not gates. A pull request that changes a measure gets a smoke run, and no other pull request starts it."
      }
    }
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.6",
    "@mark1russell7/boundaries": "^0.3.2",
    "@mark1russell7/conventions": "^0.56.0",
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/ste-lint": "^0.7.0",
    "@mark1russell7/template-cli": "^0.1.7",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
